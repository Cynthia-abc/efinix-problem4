        </mxCell>
        <mxCell id="g" value="gauss_3x3&#10;3×3高斯平滑&#10;Gray8" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf7ed;strokeColor=#68a65d;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#253345;spacing=12;arcSize=10;" vertex="1" parent="1">

        <mxCell id="front" value="canny_video_frontend&#10;右侧、底部补零刷新窗口&#10;组织有效像素与行帧标记" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fceff3;strokeColor=#c87896;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#253345;spacing=12;arcSize=10;" vertex="1" parent="1">
